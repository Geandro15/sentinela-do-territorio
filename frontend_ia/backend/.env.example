# Origens (URLs) autorizadas a chamar esta API, separadas por vírgula.
# Nunca usar "*" em produção.
BACKEND_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# As demais variáveis (modelo do Ollama, caminho do índice do RAG, caminho
# do modelo de visão treinado) já são lidas do .env da raiz do projeto e do
# visao/.env, reaproveitados por este back-end. Veja o .env.example da raiz
# e o visao/.env.example.
